{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/awaiting-validation.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "submission_id",
    "deadline_at",
    "retry_seconds",
    "attempted_at",
    "next_retry_at",
    "missing_references",
    "validation_errors",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "awaiting-validation"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "retry_seconds": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "attempted_at": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date-time"
      }
    },
    "next_retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "missing_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "instance_path"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "instance_path": {
            "type": "string"
          },
          "schema_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "submission": {}
  },
  "additionalProperties": false
}
