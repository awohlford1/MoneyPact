{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/archive-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "manifest_id",
    "batch_id",
    "entries",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "archive-manifest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record",
          "source",
          "destination",
          "digest"
        ],
        "properties": {
          "record": {
            "type": "object",
            "required": [
              "record_type",
              "record_id"
            ],
            "properties": {
              "record_type": {
                "type": "string",
                "minLength": 1
              },
              "record_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "prepared",
        "verified",
        "published",
        "failed"
      ]
    }
  },
  "additionalProperties": false
}
