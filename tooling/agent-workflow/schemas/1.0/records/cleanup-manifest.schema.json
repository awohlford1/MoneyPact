{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/cleanup-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "manifest_id",
    "mode",
    "entries",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "cleanup-manifest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "mode": {
      "enum": [
        "dry-run",
        "apply"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "planned",
        "completed",
        "failed"
      ]
    }
  },
  "additionalProperties": false
}
