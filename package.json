{
  "name": "cobudget",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative budgeting for individuals, partners, and families.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cobudget/web",
    "dev:api": "npm run dev --workspace=@cobudget/api",
    "dev:worker": "npm run dev --workspace=@cobudget/worker",
    "start:api": "npm run start --workspace=@cobudget/api",
    "start:worker": "npm run start --workspace=@cobudget/worker",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@cobudget/web",
    "gate": "node scripts/gate.mjs",
    "check:ci": "node --test scripts/check-ci-contract.test.mjs && node scripts/check-ci-contract.mjs",
    "check:env": "node --test scripts/check-environment.test.mjs && node scripts/check-environment.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check:docs": "node scripts/check-mermaid.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint": "eslint scripts && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check:ci && npm run check:secrets && npm run check:env && npm run check:publication && npm run check:docs && npm run check:tokens && npm run check:copy && npm run check:migrations && npm run check:authorization-policy-history && npm run check:rate-limit-registry && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:pages",
    "check:copy": "node scripts/check-copy-language.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:authorization-policy-history": "node --test scripts/check-authorization-policy-history.test.mjs && node scripts/check-authorization-policy-history.mjs",
    "check:rate-limit-registry": "node --test scripts/check-rate-limit-registry.test.mjs && node scripts/check-rate-limit-registry.mjs",
    "check:pages": "node scripts/check-public-pages.mjs",
    "agent:init": "npx --no-install agent-workflow init",
    "agent:doctor": "npx --no-install agent-workflow doctor",
    "agent:validate": "npx --no-install agent-workflow validate",
    "agent:capabilities": "npx --no-install agent-workflow capabilities",
    "agent:cleanup": "npx --no-install agent-workflow cleanup --apply",
    "agent:cleanup:dry-run": "npx --no-install agent-workflow cleanup --dry-run",
    "agent:archive": "npx --no-install agent-workflow archive --apply",
    "agent:archive:dry-run": "npx --no-install agent-workflow archive --dry-run"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@agent-workflow/cli": "file:.agent-workflow/vendor/agent-workflow-cli-0.1.6.tgz",
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "11.16.0",
    "eslint": "9.39.5"
  }
}
