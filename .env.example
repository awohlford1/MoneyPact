# Operator-supplied environment variables; config/environment-inventory.json is
# the machine-checked inventory for applications and repository tooling.
#
# Copy to `.env.local` (untracked) and fill in real values. Every variable an
# application reads is declared in a schema under `packages/contracts`, and
# `packages/contracts/src/config/base.test.ts` fails if a declared variable is
# missing from this file. Placeholders here are safe to commit; real secrets
# never are.

# --- Shared by every application (packages/contracts, baseConfigSchema) -------

# Runtime environment. Controls nothing on its own; applications branch on it explicitly.
# One of: development, test, production
NODE_ENV=development

# Minimum severity that is emitted. Content is fixed by the AN-92-003 allowlist regardless of level.
# One of: debug, info, warn, error
LOG_LEVEL=info

# Deployed version identifier carried on every reliability event (AN-92-003). A commit SHA or release tag.
SERVICE_VERSION=local

# --- Field encryption (apps/api and apps/worker, fieldEncryptionConfigSchema) -

# S4 field-encryption key provider. One of: local, kms.
# "local" is refused outside NODE_ENV=development/test.
COBUDGET_FIELD_ENCRYPTION_PROVIDER=local

# Secret base64-encoded 32-byte AES-256 key for the local provider. Required when the provider is "local".
COBUDGET_FIELD_ENCRYPTION_LOCAL_KEY=

# Key version recorded on ciphertext written by the local provider. Required when the provider is "local".
COBUDGET_FIELD_ENCRYPTION_KEY_VERSION=local-dev-v1

# --- API application (apps/api, apiConfigSchema) -----------------------------

# TCP port on which the API listens. Must be between 1 and 65535.
API_PORT=3001

# Interface the API binds to. Omit to use environment defaults:
# 127.0.0.1 for development/test, 0.0.0.0 for production.
API_LISTEN_ADDRESS=127.0.0.1

# --- Sessions and identity for the API application; sessionConfigSchema and identityConfigSchema (PROTO-IDENTITY-API-001) ---
#
# Required only under COBUDGET_IDENTITY_PROVIDER=local (development/test). Set
# the two secret keys to independent base64-encoded 32-byte values; a real
# secret is never committed. The web application origin must proxy /v1 to the
# API so cookies, Origin and the callback share one origin.

# Base64-encoded server-side pepper (>= 32 bytes) for session verifier and CSRF digests (CBD-191 SC-191-001). Never stored in the database. Required under the local identity provider.
COBUDGET_SESSION_PEPPER=

# Idle session expiry in seconds (CBD-191 section 5.1). Required under the local identity provider.
COBUDGET_SESSION_IDLE_TIMEOUT_SECONDS=900

# Absolute session lifetime in seconds (CBD-191 section 5.1). Required under the local identity provider.
COBUDGET_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800

# Fresh-assurance validity window in seconds (CBD-191 section 5.1). Required under the local identity provider.
COBUDGET_SESSION_FRESH_ASSURANCE_WINDOW_SECONDS=300

# Revocation propagation deadline in seconds (CBD-191 section 6.1). Required under the local identity provider.
COBUDGET_SESSION_REVOCATION_PROPAGATION_TARGET_SECONDS=60

# Maximum accepted future skew of a provider event time in seconds (CBD-191 section 6.2). Required under the local identity provider.
COBUDGET_SESSION_PROVIDER_MAX_FUTURE_SKEW_SECONDS=30

# Minimum response bucket for a session rejection in milliseconds (CBD-191 SC-191-001A). Required under the local identity provider.
COBUDGET_SESSION_REJECTION_TIMING_FLOOR_MS=20

# Random jitter added to a session rejection in milliseconds (CBD-191 SC-191-001A). Required under the local identity provider.
COBUDGET_SESSION_REJECTION_TIMING_JITTER_MS=10

# Minimum sample count for the rejection-timing differential test (CBD-191 CT-191-002A). Required under the local identity provider.
COBUDGET_SESSION_REJECTION_TIMING_SAMPLE_COUNT=50

# Response bucket used when the session store times out, in milliseconds (CBD-191 SC-191-001A). Required under the local identity provider.
COBUDGET_SESSION_REJECTION_TIMING_TIMEOUT_BUCKET_MS=40

# Maximum permitted timing differential between rejection classes in milliseconds (CBD-191 CT-191-002A). Required under the local identity provider.
COBUDGET_SESSION_REJECTION_TIMING_MAX_DIFFERENTIAL_MS=15

# Delivery-envelope key provider for sealed session delivery results (CBD-191 section 3.1). "local" is refused outside NODE_ENV=development/test; "kms" is not yet available.
COBUDGET_SESSION_ENVELOPE_KEY_PROVIDER=local

# Base64-encoded 32-byte key for the local delivery-envelope provider. Required when the envelope provider is "local". Separate custody from the session pepper and the field-encryption key.
COBUDGET_SESSION_ENVELOPE_KEY=

# Key version recorded on sealed delivery envelopes. Required when the envelope provider is "local".
COBUDGET_SESSION_ENVELOPE_KEY_VERSION=local-dev-v1

# Identity adapter. "local" is the Cognito-shaped local adapter (development/test only); "cognito" stays refused until PROVIDERS-LOCAL-001 is superseded; "unavailable" (or absent) starts the API with the fail-closed authorization boundary and no sign-in.
COBUDGET_IDENTITY_PROVIDER=local

# Identity environment row (CBD-190 section 3). Must equal NODE_ENV under the local adapter; a cross-environment value fails startup.
COBUDGET_IDENTITY_ENVIRONMENT_ID=development

# Exact OIDC issuer. Under the local adapter it must be the ceremony origin plus /v1/identity/local, on loopback.
COBUDGET_IDENTITY_ISSUER=http://127.0.0.1:3001/v1/identity/local

# Exact OAuth client identifier the adapter sends and requires in the ID token audience. Not a secret; the client is public (PKCE only).
COBUDGET_IDENTITY_CLIENT_ID=cobudget-local-web

# The one allowed initiating application origin (scheme://host[:port]). Callbacks navigate back to it; sign-in and logout requests must carry it as their Origin.
COBUDGET_IDENTITY_APPLICATION_ORIGIN=http://localhost:3000

# Origin that serves the hosted ceremony. Must differ from the application origin (CBD-190 section 8); the local adapter serves it from the API origin.
COBUDGET_IDENTITY_CEREMONY_ORIGIN=http://127.0.0.1:3001

# Exact provider-registered callback URI; its path must be /v1/identity/callback. No prefix, suffix, query or fragment matching.
COBUDGET_IDENTITY_CALLBACK_URI=http://localhost:3000/v1/identity/callback

# Lifetime of a begin challenge (state, PKCE, nonce). Required under the local adapter.
COBUDGET_IDENTITY_CHALLENGE_LIFETIME_SECONDS=600

# Maximum lifetime of one bounded token exchange, including issuer revocation (CBD-190 section 10.1). Required under the local adapter.
COBUDGET_IDENTITY_EXCHANGE_LIFETIME_MS=5000

# Maximum whole-transaction attempts for the identity mapping (CBD-190 section 5.2). Required under the local adapter.
COBUDGET_IDENTITY_MAPPING_MAX_ATTEMPTS=5

# Lifetime of a prepared session hand-off before it becomes terminal (CBD-190 section 6). Required under the local adapter.
COBUDGET_IDENTITY_HANDOFF_LIFETIME_SECONDS=120

# Accepted clock skew for provider token times (CBD-190 section 4.3). Required under the local adapter.
COBUDGET_IDENTITY_CLOCK_SKEW_SECONDS=30

# --- Local PostgreSQL (packages/migrations, local database commands) ---------

# Loopback host port for the local container. Change only when 5432 is occupied.
COBUDGET_DB_PORT=5432
# Local development database name; this is not a hosted database identifier.
COBUDGET_DB_NAME=cobudget_dev
# Bootstrap superuser for the loopback-only local container.
COBUDGET_DB_SUPERUSER=postgres
# Non-secret local bootstrap password; never reuse it outside this disposable container.
COBUDGET_DB_SUPERUSER_PASSWORD=local-only-superuser
# Non-secret local password for the migration role.
COBUDGET_DB_MIGRATION_PASSWORD=local-only-migration
# Non-secret local password for the API role.
COBUDGET_DB_API_PASSWORD=local-only-api
# Non-secret local password for the worker role.
COBUDGET_DB_WORKER_PASSWORD=local-only-worker

# --- Repository tooling; required only when the corresponding tool runs ------

# Confluence HTTPS site origin; no credentials, path, query, fragment, or port.
CONFLUENCE_BASE_URL=https://example.atlassian.net
# Confluence operator email; synthetic placeholder, replace locally.
CONFLUENCE_EMAIL=operator@example.invalid
# Secret Confluence token; intentionally empty. Never commit a real value.
CONFLUENCE_API_TOKEN=

# Workflow-only read token for publication checkpoints. No local value needed.
GH_TOKEN=

# Optional Jira HTTPS site origin; omission defaults to https://cobudget.atlassian.net.
JIRA_BASE_URL=https://example.atlassian.net
# Jira operator email; synthetic placeholder, replace locally.
JIRA_EMAIL=operator@example.invalid
# Secret Jira token; intentionally empty. Never commit a real value.
JIRA_API_TOKEN=
