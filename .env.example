# Operator-supplied environment variables; config/environment-inventory.json is
# the machine-checked inventory for applications and repository tooling.
#
# Copy to `.env.local` (untracked) and fill in real values. Every variable an
# application reads is declared in a schema under `packages/contracts`, and
# `packages/contracts/src/config/base.test.ts` fails if a declared variable is
# missing from this file. Placeholders here are safe to commit; real secrets
# never are.

# --- Shared by every application (packages/contracts, baseConfigSchema) -------

# Runtime environment. Controls nothing on its own; applications branch on it explicitly.
# One of: development, test, production
NODE_ENV=development

# Minimum severity that is emitted. Content is fixed by the AN-92-003 allowlist regardless of level.
# One of: debug, info, warn, error
LOG_LEVEL=info

# Deployed version identifier carried on every reliability event (AN-92-003). A commit SHA or release tag.
SERVICE_VERSION=local

# --- API application (apps/api, apiConfigSchema) -----------------------------

# TCP port on which the API listens. Must be between 1 and 65535.
API_PORT=3001

# Interface the API binds to. Omit to use environment defaults:
# 127.0.0.1 for development/test, 0.0.0.0 for production.
API_LISTEN_ADDRESS=127.0.0.1

# --- Repository tooling; required only when the corresponding tool runs ------

# Confluence HTTPS site origin; no credentials, path, query, fragment, or port.
CONFLUENCE_BASE_URL=https://example.atlassian.net
# Confluence operator email; synthetic placeholder, replace locally.
CONFLUENCE_EMAIL=operator@example.invalid
# Secret Confluence token; intentionally empty. Never commit a real value.
CONFLUENCE_API_TOKEN=

# Workflow-only read token for publication checkpoints. No local value needed.
GH_TOKEN=

# Optional Jira HTTPS site origin; omission defaults to https://cobudget.atlassian.net.
JIRA_BASE_URL=https://example.atlassian.net
# Jira operator email; synthetic placeholder, replace locally.
JIRA_EMAIL=operator@example.invalid
# Secret Jira token; intentionally empty. Never commit a real value.
JIRA_API_TOKEN=
