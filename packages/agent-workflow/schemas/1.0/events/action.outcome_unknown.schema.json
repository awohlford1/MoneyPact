{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/events/action.outcome_unknown.schema.json",
  "type": "object",
  "required": [
    "action_id",
    "outcome"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^act-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "outcome": {
      "const": "unknown"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
