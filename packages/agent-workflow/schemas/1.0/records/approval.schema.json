{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/approval.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "approval_id",
    "assignment_id",
    "subject",
    "subject_revision",
    "state",
    "approver",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "approval"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^apr-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^asn-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "subject": {
      "type": "object",
      "required": [
        "record_type",
        "record_id"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "subject_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "requested",
        "granted",
        "rejected",
        "revoked",
        "expired",
        "waived"
      ]
    },
    "approver": {
      "type": "object",
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "actor_type": {
          "enum": [
            "executive",
            "manager",
            "specialist",
            "runtime",
            "external_system"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "waiver_authority": {
      "type": "object",
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "actor_type": {
          "enum": [
            "executive",
            "manager",
            "specialist",
            "runtime",
            "external_system"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "record_only",
            "signed_ed25519"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "const": "granted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "granted_at"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "state": {
            "const": "waived"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "waiver_authority"
        ]
      }
    }
  ]
}
