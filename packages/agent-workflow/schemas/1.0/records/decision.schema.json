{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/decision.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "decision_id",
    "assignment_id",
    "subject",
    "choice",
    "rationale",
    "decided_by"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "decision"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^dec-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^asn-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "subject": {
      "type": "object",
      "required": [
        "record_type",
        "record_id"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "decided_by": {
      "type": "object",
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "actor_type": {
          "enum": [
            "executive",
            "manager",
            "specialist",
            "runtime",
            "external_system"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
