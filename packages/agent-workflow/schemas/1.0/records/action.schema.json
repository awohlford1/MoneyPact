{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/action.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "action_id",
    "assignment_id",
    "description",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "action"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^act-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^asn-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tsk-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^exe-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "consequential": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "requested",
        "started",
        "succeeded",
        "failed",
        "prevented",
        "cancelled",
        "unknown"
      ]
    },
    "intent_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^evt-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "outcome_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^evt-[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "additionalProperties": false
}
