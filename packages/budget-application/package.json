    "./transactions": "./src/transactions/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cobudget/budget-domain": "*"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.0"
  }
}
