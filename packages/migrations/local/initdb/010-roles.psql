-- Local development roles (CBD-117-AC05).
--
-- Runs once, as the bootstrap superuser, inside the database named by
-- POSTGRES_DB, the first time the volume is initialised. The .psql suffix is
-- intentionally ignored by the image entrypoint; 010-roles.sh invokes it once
-- with the environment-contract values bound as safely quoted psql variables.
-- It is NOT a migration: the migration check does not read this directory,
-- the ledger never records it, and nothing here runs hosted. Hosted
-- provisioning (CBD-119) creates the same three roles by the same names and
-- makes the migration role the database owner; grants live in migrations/ so
-- they are identical locally and hosted by construction.
--
-- DP-105-003: api and worker hold data-manipulation rights on application
-- schemas only, while the migration role holds schema-change rights.

CREATE ROLE cobudget_migration LOGIN :role_option :'migration_password';
CREATE ROLE cobudget_api LOGIN :role_option :'api_password';
CREATE ROLE cobudget_worker LOGIN :role_option :'worker_password';

-- PostgreSQL 15+ grants CREATE on public to the database owner only.
ALTER DATABASE :"database_name" OWNER TO cobudget_migration;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
